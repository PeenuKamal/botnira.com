# BotNira — Apache config for Hostinger shared hosting
# Upload this file together with the site into public_html/.

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Force HTTPS and the bare domain (botnira.com) -------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^ https://botnira.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.botnira\.com$ [NC]
RewriteRule ^ https://botnira.com%{REQUEST_URI} [L,R=301]

# --- Block private folders and dev files -----------------------------------
RewriteRule ^(includes|storage)(/|$) - [F,L]
RewriteRule ^(router\.php|README\.md|DEPLOY\.md|\.git.*)$ - [F,L]

# --- Old URLs from the previous site ----------------------------------------
RewriteRule ^brand/botnira-mark(-512)?\.png$ /assets/img/botnira-mark$1.png [L,R=301]
RewriteRule ^(app|admin)(/.*)?$ /login [L,R=302]
RewriteRule ^forgot-password/?$ /login [L,R=302]
RewriteRule ^r/([A-Za-z0-9_-]+)/?$ /signup?ref=$1 [L,R=302]

# --- Strip trailing slash and .php from URLs --------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.php[\s?] [NC]
RewriteCond %1 !^api/
RewriteRule ^ /%1 [L,R=301]

# --- Pretty URLs ------------------------------------------------------------
RewriteRule ^use-case/([a-z0-9-]+)$ use-case.php?slug=$1 [L,QSA]
RewriteRule ^(ai-sales-agent|ai-appointment-booking-software|ai-chatbot-for-immigration-consultants|replace-sales-team-with-ai|whatsapp-ai-assistant|24-7-ai-receptionist)$ solution.php?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)$ $1.php [L,QSA]
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Browser caching (CSS/JS use ?v= cache-busting, so long caching is safe) -
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType audio/mp4 "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

AddType audio/mp4 .m4a
